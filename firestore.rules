rules_version = '2';
// Reglas de seguridad del Calendario de Adviento.
// Copia TODO este texto en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function secret() { return get(/databases/$(database)/documents/adminSecret/main).data.hash; }
    // La dueña: se compara la HUELLA (SHA-256) de su correo, así el correo no está escrito aquí (V23.5)
    function isOwner() { return signedIn() && request.auth.token.email != null
      && hashing.sha256(request.auth.token.email.lower()).toHexString().lower() == 'ee23a431f55e0250e0dc5aa98ac9520e7f526d62c4e802b96ca4fd1b4ff45466'; }
    // «Abrir todas las casillas a todos» (lo activa la administradora)
    function openAll() { return get(/databases/$(database)/documents/config/public).data.get('openAll', false) == true; }
    // «Casillas abiertas antes de tiempo» para una persona concreta (lo activa la administradora en su ficha; solo antes de diciembre)
    function early() {
      return request.time.month() != 12
        && exists(/databases/$(database)/documents/settings/$(request.auth.uid))
        && get(/databases/$(database)/documents/settings/$(request.auth.uid)).data.get('earlyOpen', false) == true;
    }
    // Palabra secreta de la familia: si la administradora la ha puesto, solo la familia ve y escribe cosas
    function famSet() { return exists(/databases/$(database)/documents/famSecret/main); }
    function famOk(k) { return !famSet() || get(/databases/$(database)/documents/famSecret/main).data.hash == k; }
    function member() {
      return isOwner() || !famSet()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('famKey', '') == get(/databases/$(database)/documents/famSecret/main).data.hash);
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.key == secret();
    }

    // Perfil de cada persona (nombre, idioma, estilo de nota)
    match /users/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if me(uid) && (isOwner() || famOk(request.resource.data.get('famKey', '')));
      allow update: if isAdmin();
      allow list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Lo que decide la administradora (figura, progreso visible, actividades personales)
    match /settings/{uid} {
      allow read: if me(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Respuestas: cada persona puede enviar UNA vez cada día; solo la administradora corrige
    match /answers/{uid}/items/{day} {
      allow read: if me(uid) || isAdmin();
      allow create: if me(uid) && member() && request.resource.data.status in ['pending', 'correct', 'incorrect'];
      allow create, update, delete: if isAdmin();
      // en diciembre, cada persona borra lo que hizo antes (al probar en noviembre) para empezar de 0
      allow delete: if me(uid) && request.time.month() == 12
        && resource.data.at < timestamp.date(request.time.year(), 12, 1).toMillis() - 3600000;
    }

    // Contenido de cada día: solo visible a partir de su fecha (la administradora lo ve siempre)
    match /content/{day}/media/{id} {
      allow read: if signedIn() && (isAdmin() || (member() && (openAll() || early() || request.time >= get(/databases/$(database)/documents/content/$(day)).data.openAt)));
      allow write: if isAdmin();
    }
    match /content/{day} {
      allow read: if signedIn() && (isAdmin() || (member() && (resource == null || request.time >= resource.data.openAt || openAll() || early())));
      allow write: if isAdmin();
    }

    // Ajustes generales (año, premios)
    match /config/{doc} {
      allow read: if signedIn() && (member() || isAdmin());
      allow write: if isAdmin();
    }

    // Huella de la palabra secreta de la familia: nadie la puede leer; solo la administradora la cambia
    match /famSecret/{doc} {
      allow read: if false;
      allow write: if isAdmin();
    }
    // Solo dice si hay palabra secreta o no
    match /famInfo/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Cosas que solo se pueden hacer UNA vez (la tirada de la máquina de regalos): no se pueden cambiar
    match /once/{uid}/items/{id} {
      allow read: if me(uid) || isAdmin();
      // la máquina de regalos es solo para los gnomos
      allow create: if me(uid) && member() && (id != 'slot'
        || (exists(/databases/$(database)/documents/settings/$(uid))
            && get(/databases/$(database)/documents/settings/$(uid)).data.get('figure', 'galleta') == 'gnomo'));
      allow delete: if isAdmin() || (me(uid) && request.time.month() == 12
        && resource.data.at < timestamp.date(request.time.year(), 12, 1).toMillis() - 3600000);
    }

    // Contraseña de configuración cifrada (hash). Nadie puede leerla.
    match /adminSecret/{doc} {
      allow read: if false;
      // solo la dueña la crea (la primera vez, o si la ha borrado ella desde Firebase porque la olvidó);
      // para cambiarla hay que saber la actual: no basta con haber entrado en su cuenta
      allow create: if isOwner() && doc == 'main';
      allow update: if isAdmin();
    }

    // Quien escribe aquí la contraseña correcta pasa a ser administrador
    match /admins/{uid} {
      allow read: if me(uid);
      allow create, update: if me(uid)
        && request.resource.data.key == getAfter(/databases/$(database)/documents/adminSecret/main).data.hash;
    }

    // Registro de entradas en la cuenta de la administradora: nadie lo puede cambiar ni borrar
    match /adminLog/{id} {
      allow create: if isOwner() && request.resource.data.at is int;
      allow read: if isOwner();
      allow update, delete: if false;
    }

    // Mensajes sorpresa que la administradora prepara para cada persona y día
    match /surprises/{uid}/msgs/{id} {
      allow read: if me(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Quién está dentro de la app: cada persona escribe el suyo; solo la administradora principal lo ve y puede echar
    match /presence/{uid} {
      allow read: if me(uid) || isOwner();
      allow list: if isOwner();
      allow create, update: if me(uid) || isOwner();
      allow delete: if isOwner();
    }

    // Nombres que se escriben al entrar: no se pueden repetir
    match /names/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && member() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
    }

    // ================= (V24) JUEGO DE LOS GNOMOS =================
    function gnome() {
      return signedIn() && exists(/databases/$(database)/documents/settings/$(request.auth.uid))
        && get(/databases/$(database)/documents/settings/$(request.auth.uid)).data.get('figure', 'galleta') == 'gnomo';
    }
    function gq(q) { return get(/databases/$(database)/documents/gq/$(q)).data; }
    // la pregunta está en juego: ya ha salido y aún no ha salido la siguiente
    function gOpen(q) { return exists(/databases/$(database)/documents/gq/$(q)) && request.time >= gq(q).atTs && request.time < gq(q).untilTs; }
    function gAllowed(q) { return gq(q).get('to', null) == null || request.auth.uid in gq(q).to; }
    // mi respuesta: la hora la pone el servidor y «ok» tiene que ser verdad (se compara con la huella de la respuesta buena)
    function gMine(q) {
      let a = request.resource.data[request.auth.uid];
      return a.keys().hasOnly(['n', 'a', 'ok', 'at', 'nm']) && a.n is string && a.n.size() < 300 && a.a is string && a.a.size() < 300
        && a.at == request.time && a.ok == (hashing.sha256(q + ':' + a.n).toHexString().lower() in gq(q).hs);
    }
    // las respuestas de los demás solo se ven después de contestar (o cuando la pregunta ya se ha cerrado)
    function gCanSee(q) {
      return resource == null || request.auth.uid in resource.data
        || request.time >= gq(q).untilTs || !gAllowed(q);
    }
    // marcador, metas, premios, horas de las preguntas y puntos puestos a mano
    match /gnome/{doc} {
      allow read: if isAdmin() || gnome();
      allow write: if isAdmin();
    }
    // cada pregunta: solo se puede leer a partir de su hora
    match /gq/{q} {
      allow read: if isAdmin() || (gnome() && request.time >= resource.data.atTs
        && (resource.data.get('to', null) == null || request.auth.uid in resource.data.to));
      allow write: if isAdmin();
    }
    // la respuesta buena en claro: solo la administradora
    match /gqk/{q} {
      allow read, write: if isAdmin();
    }
    // fotos de los premios
    match /gimg/{id} {
      allow read: if isAdmin() || gnome();
      allow write: if isAdmin();
    }
    // respuestas: cada gnomo contesta UNA vez mientras está en juego; el más rápido elige a quién quitar 1 punto
    match /ga/{q} {
      allow read: if isAdmin() || (gnome() && gCanSee(q));
      allow create: if gnome() && gOpen(q) && gAllowed(q)
        && request.resource.data.keys().hasOnly([request.auth.uid]) && gMine(q);
      allow update: if gnome() && (
        (gOpen(q) && gAllowed(q) && !(request.auth.uid in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([request.auth.uid]) && gMine(q))
        || (!('steal' in resource.data) && request.auth.uid in resource.data && resource.data[request.auth.uid].ok == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['steal'])
          && request.resource.data.steal.by == request.auth.uid && request.resource.data.steal.to is string
          && request.resource.data.steal.to != request.auth.uid));
      allow write: if isAdmin();
    }

    // (V24.1) puntos de gnomo ganados en los juegos (p. ej. Dulce Navidad del día 8): cada gnomo escribe solo los suyos
    match /gb/{id} {
      allow read: if isAdmin() || gnome();
      allow create, update: if gnome() && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.game
        && request.resource.data.keys().hasOnly(['uid', 'game', 'start', 'lv', 'pts', 'at', 'neg', 'negd', 'nat'])
        && (!('neg' in request.resource.data) || (request.resource.data.neg is int && request.resource.data.neg >= 0 && request.resource.data.neg <= 60))
        && request.resource.data.game is string && request.resource.data.game.matches('[a-z0-9]{1,16}')
        && request.resource.data.lv is int && request.resource.data.lv >= 0 && request.resource.data.lv <= 300
        && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 300;
      allow delete: if isAdmin();
    }

    // (V24.2) ⭐ Marcador de Navidad (para todos): cada uno escribe solo el suyo y no puede sumar más de 4 de golpe (V26: el parchís da 4 al 1.º); todos ven la clasificación
    match /pts/{uid} {
      allow read: if signedIn() && (member() || isAdmin());
      allow create, update: if me(uid) && member() && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'fig', 'total', 'games', 'hist', 'at'])
        && request.resource.data.total is int && request.resource.data.total >= 0
        && request.resource.data.total <= (resource == null ? 0 : resource.data.total) + 4
        && request.resource.data.name is string && request.resource.data.name.size() < 60
        && request.resource.data.hist is list && request.resource.data.hist.size() <= 120;
      allow write: if isAdmin();
    }

    // ================= (V26) PARCHÍS EN LÍNEA =================
    // Quién tiene la app abierta (solo el nombre y la figura): lo ve la familia para invitar a jugar
    match /online/{uid} {
      allow read: if signedIn() && (member() || isAdmin());
      allow write: if me(uid) && member();
    }
    // Invitaciones: cualquiera de la familia puede invitar; cada uno lee las suyas
    match /pinv/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if signedIn() && member()
        && request.resource.data.keys().hasOnly(['gid', 'from', 'fn', 'at', 'pen', 'msg', 'reply'])
        && (!('msg' in request.resource.data) || (request.resource.data.msg is string && request.resource.data.msg.size() <= 200));
      allow delete: if me(uid) || isAdmin();
    }
    // Cada partida: la ven y la mueven solo los que están en ella
    match /pgame/{gid} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid in resource.data.pl);
      allow create: if signedIn() && member() && request.resource.data.host == request.auth.uid && request.auth.uid in request.resource.data.pl;
      allow update: if signedIn() && member() && request.auth.uid in resource.data.pl && request.resource.data.host == resource.data.host;
      allow delete: if isAdmin() || (signedIn() && resource.data.host == request.auth.uid);
    }

    // Tarjeta de Navidad del día 25
    match /cards/{uid} {
      allow read: if me(uid) || isAdmin();
      allow write: if me(uid) && member();
      allow delete: if isAdmin() || me(uid);
    }
  }
}
