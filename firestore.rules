rules_version = '2';
// Reglas de seguridad del Calendario de Adviento.
// Copia TODO este texto en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    function secret() { return get(/databases/$(database)/documents/adminSecret/main).data.hash; }
    // Es administrador quien ha entrado con la contraseña de configuración vigente
    function isOwner() { return signedIn() && request.auth.token.email == 'elialtarriba@gmail.com'; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.key == secret();
    }

    // Perfil de cada persona (nombre, idioma, estilo de nota)
    match /users/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create, update: if me(uid);
      allow list: if isAdmin();
    }

    // Lo que decide la administradora (figura, progreso visible, actividades personales)
    match /settings/{uid} {
      allow read: if me(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Respuestas: cada persona puede enviar UNA vez cada día; solo la administradora corrige
    match /answers/{uid}/items/{day} {
      allow read: if me(uid) || isAdmin();
      allow create: if me(uid) && request.resource.data.status in ['pending', 'correct', 'incorrect'];
      allow create, update, delete: if isAdmin();
    }

    // Contenido de cada día: solo visible a partir de su fecha (la administradora lo ve siempre)
    match /content/{day}/media/{id} {
      allow read: if signedIn() && (isAdmin() || request.time >= get(/databases/$(database)/documents/content/$(day)).data.openAt);
      allow write: if isAdmin();
    }
    match /content/{day} {
      allow read: if signedIn() && (resource == null || request.time >= resource.data.openAt || isAdmin());
      allow write: if isAdmin();
    }

    // Ajustes generales (año, premios)
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Contraseña de configuración cifrada (hash). Nadie puede leerla.
    match /adminSecret/{doc} {
      allow read: if false;
      allow create: if signedIn() && doc == 'main';
      allow update: if isAdmin() || isOwner();
    }

    // Quien escribe aquí la contraseña correcta pasa a ser administrador
    match /admins/{uid} {
      allow read: if me(uid);
      allow create, update: if me(uid)
        && request.resource.data.key == getAfter(/databases/$(database)/documents/adminSecret/main).data.hash;
    }

    // Mensajes sorpresa que la administradora prepara para cada persona y día
    match /surprises/{uid}/msgs/{id} {
      allow read: if me(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Quién está dentro de la app: cada persona escribe el suyo; solo la administradora principal lo ve y puede echar
    match /presence/{uid} {
      allow read: if me(uid) || isOwner();
      allow list: if isOwner();
      allow create, update: if me(uid) || isOwner();
    }

    // Nombres que se escriben al entrar: no se pueden repetir
    match /names/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
    }

    // Tarjeta de Navidad del día 25
    match /cards/{uid} {
      allow read: if me(uid) || isAdmin();
      allow write: if me(uid);
    }
  }
}
